# ---------------------------------------------------------------------------
# 全部为可选项。不填任何内容时，服务会进入 Mock 演示模式：
# 用内置的生成器产出真实可交互、可持久化的应用，离线也能完整演示主流程。
# ---------------------------------------------------------------------------

# 任意 OpenAI 兼容的接口。下面几组任选其一，按需取消注释即可。
#
# DeepSeek（国内可直连，性价比高，推荐）
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
#
# Moonshot Kimi（国内可直连）
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=kimi-latest
#
# 硅基流动 SiliconFlow（国内可直连，模型选择多）
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=deepseek-ai/DeepSeek-V3
#
# 智谱 GLM
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-plus
#
# 通义千问（DashScope 兼容模式）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
#
# OpenAI（需要能访问 api.openai.com）
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 单次生成的最大输出长度。deepseek-chat 上限 8192，留 8000 比较稳；
# 如果服务商提示 max_tokens 超限，代码会自动降到 4096 重试一次。
LLM_MAX_TOKENS=8000

# 服务端口与公开地址（部署后填写，用于生成分享链接）
PORT=8787
APP_BASE_URL=

# 存储驱动：sqlite（默认，本地单机）| turso（云 SQLite，推荐用于临时磁盘的托管平台）
#            redis（Upstash REST，另一条云持久化路径）
# 不显式指定时：只要下面 TURSO_DATABASE_URL 和 TURSO_AUTH_TOKEN 都填了，自动启用 turso；
# Turso 连不上会自动回落 sqlite，服务不会因此挂掉。
STORAGE=sqlite
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=